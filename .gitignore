# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# Optional: ignore plan files saved before destroying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout

# ---------- platform-lab additions ----------

# Kubeconfigs — never commit, even for local clusters
kubeconfig
kubeconfig.*
*.kubeconfig
.kube/

# Secrets / credentials
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
*.secret
*.secret.yaml
*-secret.yaml

# Environment files
.env
.env.*
!.env.example

# Helm
# No charts/*.tgz ignore on purpose: vendored charts under
# platform/**/charts/ ARE committed (see ADR 0004). Only the local
# Helm home/cache is ignored.
.helm/
# Built dependency artifacts of the local 'common' library chart —
# regenerated from charts/common/ by `helm dependency update` (install.sh
# + CI), so not committed. Scoped to apps/ to leave the vendored
# observability charts under platform/**/charts/ tracked.
apps/podinfo/charts/
apps/podinfo/Chart.lock

# Local Kubernetes state
*.tar
*.tar.gz

# macOS
.DS_Store

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Logs / temp
*.log
tmp/
.tmp/

# Local-only script hooks (env-specific, never committed)
*.local.sh
*.local.yaml
*.local
