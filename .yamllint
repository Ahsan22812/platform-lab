# yamllint config for platform-lab.
# Pragmatic, not pedantic: catch real mistakes (syntax, duplicate keys,
# trailing whitespace), don't nag about cosmetics.

extends: default

ignore: |
  platform/observability/**/charts/

rules:
  # Disabled: image digests (e.g. podinfo's pinned sha256) and command
  # URLs are single tokens that exceed any sane width and can't be
  # wrapped — enforcing a limit would conflict with digest pinning.
  # The valuable structural rules below stay on.
  line-length: disable
  # Leading `---` is optional in this repo.
  document-start: disable
  # `on:` in GitHub workflows is a key, not a boolean — don't flag it.
  truthy:
    check-keys: false
  comments:
    min-spaces-from-content: 1
